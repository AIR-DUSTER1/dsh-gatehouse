# Server
PORT=8787
HOST=127.0.0.1
DATABASE_PATH=./data/console.db
SESSION_SECRET=replace-with-a-long-random-secret
PLUGIN_EVENT_SECRET=replace-with-another-long-random-secret
PLUGIN_SHARED_SECRET=replace-with-plugin-shared-secret
PLUGIN_BASE_URL=http://127.0.0.1:8790
PLUGIN_MODE=mock
SCHEDULE_POLL_MS=1000
SCHEDULE_MAX_CONCURRENCY=2
PLUGIN_TIMEOUT_MS=5000
PLUGIN_MAX_ATTEMPTS=5
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=Gatehouse Admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-characters
WEB_ORIGIN=http://127.0.0.1:5173

# Web
VITE_API_BASE=

SESSION_TTL_SECONDS=28800

# Repository onboarding
REPOSITORY_HOST_ALLOWLIST=
ALLOW_PRIVATE_REPOSITORY_HOSTS=false
