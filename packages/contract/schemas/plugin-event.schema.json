{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.local/schemas/plugin-event.schema.json",
  "title": "PluginEventEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "event_id", "event_type", "occurred_at", "trace_id", "data"],
  "properties": {
    "version": { "enum": ["1.0", "2.0"] },
    "event_id": { "type": "string", "minLength": 1 },
    "event_type": { "enum": ["proposal.created", "proposal.updated", "proposal.superseded", "execution.started", "execution.finished", "execution.failed"] },
    "occurred_at": { "type": "string", "format": "date-time" },
    "trace_id": { "type": "string", "minLength": 1 },
    "data": { "type": "object" }
  }
}
