{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.local/schemas/proposal.schema.json",
  "title": "Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "review_case_id", "assessment_revision", "summary", "scope", "scope_hash", "rule_hits", "impact_files", "test_plan", "estimated_cost", "risk", "risk_reason", "status", "created_at", "updated_at"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "review_case_id": { "type": "string", "minLength": 1 },
    "assessment_revision": { "type": "integer", "minimum": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "scope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "scope_hash": { "$ref": "#/$defs/hash" },
    "rule_hits": { "type": "array", "items": { "type": "string" } },
    "impact_files": { "type": "array", "items": { "type": "string" } },
    "test_plan": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "estimated_cost": { "type": "string", "minLength": 1 },
    "risk": { "enum": ["low", "medium", "high", "critical"] },
    "risk_reason": { "type": "string", "minLength": 1 },
    "status": { "enum": ["pending_review", "info_requested", "approved", "rejected", "superseded", "scheduled", "executing", "completed", "failed"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
