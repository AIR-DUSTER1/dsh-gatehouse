{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.local/schemas/routing-decision.schema.json",
  "title": "RoutingDecision",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "workspace_id", "repository_id", "source", "mode", "confidence", "reason", "candidates", "requires_human", "created_at"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "workspace_id": { "type": ["string", "null"] },
    "repository_id": { "type": ["string", "null"] },
    "source": { "enum": ["feishu", "github", "gitlab", "gitea", "webhook", "manual"] },
    "mode": { "enum": ["explicit", "native", "thread", "semantic", "manual"] },
    "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["workspace_id", "repository_id", "confidence", "reason"],
        "properties": {
          "workspace_id": { "type": "string", "minLength": 1 },
          "repository_id": { "type": ["string", "null"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "requires_human": { "type": "boolean" },
    "overridden_by": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
